# Copy this file to relay.env and update each value for your network.
# This file contains public settings only; never put private keys here.
WOMBAT_RELAY=/ip4/RELAY_PUBLIC_IP/tcp/9000/p2p/RELAY_PEER_ID
WOMBAT_TOPIC=wombat/pe/piura/piura-demo/change
WOMBAT_TRUSTED_ISSUERS=./trusted-issuers.json
WOMBAT_IDENTITY_KEY=./wombat-transport.key
WOMBAT_LISTEN=/ip4/0.0.0.0/tcp/0
