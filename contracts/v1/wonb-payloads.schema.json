{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wombat/contracts/v1/wonb-payloads",
  "title": "WONB payloads (sin floats, R16)",
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aoi_id",
        "data_origin",
        "t1",
        "t2",
        "polarization",
        "frequency",
        "pixel_spacing_m",
        "delta_db_threshold_cdb",
        "aoi_valid_bp",
        "aoi_decrease_bp",
        "aoi_increase_bp",
        "overlay_sha256",
        "cells_geojson_sha256"
      ],
      "properties": {
        "aoi_id": {
          "type": "string"
        },
        "data_origin": {
          "enum": [
            "nisar_real",
            "simulated"
          ]
        },
        "t1": {
          "type": "string",
          "format": "date-time"
        },
        "t2": {
          "type": "string",
          "format": "date-time"
        },
        "polarization": {
          "type": "string"
        },
        "frequency": {
          "enum": [
            "A",
            "B"
          ]
        },
        "pixel_spacing_m": {
          "type": "integer",
          "minimum": 1
        },
        "delta_db_threshold_cdb": {
          "type": "integer",
          "minimum": 1
        },
        "aoi_valid_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "aoi_decrease_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "aoi_increase_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "overlay_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t1.png",
            "t2.png",
            "delta.png"
          ],
          "properties": {
            "t1.png": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "t2.png": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "delta.png": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "cells_geojson_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aoi_id",
        "roads_total_m",
        "road_buffer_m",
        "osm_retrieved_at",
        "roads_geojson_sha256"
      ],
      "properties": {
        "aoi_id": {
          "type": "string"
        },
        "roads_total_m": {
          "type": "integer",
          "minimum": 0
        },
        "road_buffer_m": {
          "type": "integer",
          "minimum": 0
        },
        "osm_retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "roads_geojson_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "status",
        "rank",
        "score_bp",
        "components_bp",
        "metrics",
        "explanation"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-r[0-9]{2}c[0-9]{2}$"
        },
        "status": {
          "enum": [
            "review_high",
            "review_medium",
            "review_low",
            "insufficient_quality"
          ]
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "score_bp": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "components_bp": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "change",
                "opera",
                "road"
              ],
              "properties": {
                "change": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "opera": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "road": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid_bp",
            "decrease_bp",
            "increase_bp",
            "changed_bp",
            "p90_abs_delta_cdb",
            "opera_status",
            "opera_overlap_bp",
            "road_m_near_change",
            "road_m_total"
          ],
          "properties": {
            "valid_bp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "decrease_bp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "increase_bp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "changed_bp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "p90_abs_delta_cdb": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "opera_status": {
              "enum": [
                "corroborated",
                "not_corroborated",
                "unavailable"
              ]
            },
            "opera_overlap_bp": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "road_m_near_change": {
              "type": "integer",
              "minimum": 0
            },
            "road_m_total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "explanation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "insufficient_quality"
              }
            }
          },
          "then": {
            "properties": {
              "rank": {
                "type": "null"
              },
              "score_bp": {
                "type": "null"
              },
              "components_bp": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "rank": {
                "type": "integer"
              },
              "score_bp": {
                "type": "integer"
              },
              "components_bp": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "rank",
        "action",
        "audience"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-r[0-9]{2}c[0-9]{2}$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "const": "field_verification_first"
        },
        "audience": {
          "type": "string"
        }
      }
    }
  }
}
