{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wombat/contracts/v1/bundle-index",
  "title": "WOMBAT bundle index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "bundle_version",
    "aoi_id",
    "data_origin",
    "generated_at",
    "core_commit",
    "files"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "aoi_id": {
      "type": "string"
    },
    "data_origin": {
      "enum": [
        "nisar_real",
        "simulated"
      ]
    },
    "purpose": {
      "enum": [
        "scientific",
        "baseline",
        "preparation"
      ],
      "description": "Salida científica comparable o paquete no operativo de baseline/preparación."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "core_commit": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_version": {
            "pattern": "^1\\.2\\.[0-9]+$"
          }
        },
        "required": ["contract_version"]
      },
      "then": {
        "required": ["purpose"]
      }
    }
  ]
}
