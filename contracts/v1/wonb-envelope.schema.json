{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wombat/contracts/v1/wonb-envelope",
  "title": "WONB envelope v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wonb_version",
    "id",
    "type",
    "topic",
    "issued_at",
    "valid_until",
    "issuer",
    "parents",
    "payload",
    "provenance",
    "signature"
  ],
  "properties": {
    "wonb_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "type": {
      "enum": [
        "change",
        "context",
        "risk",
        "action"
      ]
    },
    "topic": {
      "type": "string",
      "pattern": "^wombat/(?:pe/[a-z0-9-]+/[a-z0-9-]+|th/thailand/[a-z0-9-]+)/(change|context|risk|action)$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuer": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}$"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "method",
        "code_commit"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "product"
            ],
            "properties": {
              "product": {
                "type": "string"
              }
            }
          }
        },
        "method": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "change"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "wonb-payloads#/$defs/change"
          },
          "valid_until": {
            "type": "null"
          },
          "parents": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "context"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "wonb-payloads#/$defs/context"
          },
          "valid_until": {
            "type": "null"
          },
          "parents": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "risk"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "wonb-payloads#/$defs/risk"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "parents": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "wonb-payloads#/$defs/action"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "parents": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ]
}
