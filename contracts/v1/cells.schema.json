{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wombat/contracts/v1/cells",
  "title": "WOMBAT cells (Python → Rust)",
  "type": "object",
  "$defs": {
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "aoi_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "AOI dueño de esta colección; obligatorio en el perfil integrado por AOI."
    },
    "crs_compute": {
      "type": "string",
      "pattern": "^EPSG:(326|327)\\d{2}$",
      "description": "CRS proyectado usado para los cálculos, no el CRS WGS84 de las geometrías."
    },
    "crs_note": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Polygon"
              },
              "coordinates": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell_id",
              "valid_fraction",
              "decrease_fraction",
              "increase_fraction",
              "changed_fraction",
              "p90_abs_delta_db",
              "opera_status",
              "opera_overlap_ratio",
              "road_m_near_change",
              "road_m_total"
            ],
            "properties": {
              "aoi_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "cell_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-r[0-9]{2}c[0-9]{2}$"
              },
              "valid_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "decrease_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "increase_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "changed_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "p90_abs_delta_db": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "opera_status": {
                "enum": [
                  "corroborated",
                  "not_corroborated",
                  "unavailable"
                ]
              },
              "opera_overlap_ratio": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "road_m_near_change": {
                "type": "integer",
                "minimum": 0
              },
              "road_m_total": {
                "type": "integer",
                "minimum": 0
              },
              "source_status": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nisar",
                  "opera",
                  "osm"
                ],
                "properties": {
                  "nisar": {
                    "enum": [
                      "available",
                      "unavailable",
                      "simulated"
                    ]
                  },
                  "opera": {
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  },
                  "osm": {
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  }
                }
              },
              "provenance_refs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nisar",
                  "opera",
                  "osm"
                ],
                "properties": {
                  "nisar": {
                    "$ref": "#/$defs/provenance_refs"
                  },
                  "opera": {
                    "$ref": "#/$defs/provenance_refs"
                  },
                  "osm": {
                    "$ref": "#/$defs/provenance_refs"
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "opera_status": {
                      "const": "unavailable"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "opera_overlap_ratio": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "opera_overlap_ratio": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["aoi_id"]
      },
      "then": {
        "required": ["crs_compute"],
        "properties": {
          "features": {
            "items": {
              "properties": {
                "properties": {
                  "required": [
                    "aoi_id",
                    "source_status",
                    "provenance_refs"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
