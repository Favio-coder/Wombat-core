{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wombat/contracts/v1/cells",
  "title": "WOMBAT cells (Python → Rust)",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "crs_note": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Polygon"
              },
              "coordinates": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell_id",
              "valid_fraction",
              "decrease_fraction",
              "increase_fraction",
              "changed_fraction",
              "p90_abs_delta_db",
              "opera_status",
              "opera_overlap_ratio",
              "road_m_near_change",
              "road_m_total"
            ],
            "properties": {
              "cell_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-r[0-9]{2}c[0-9]{2}$"
              },
              "valid_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "decrease_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "increase_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "changed_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "p90_abs_delta_db": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "opera_status": {
                "enum": [
                  "corroborated",
                  "not_corroborated",
                  "unavailable"
                ]
              },
              "opera_overlap_ratio": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "road_m_near_change": {
                "type": "integer",
                "minimum": 0
              },
              "road_m_total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "opera_status": {
                      "const": "unavailable"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "opera_overlap_ratio": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "opera_overlap_ratio": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
